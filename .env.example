# Copy this file to `.env` (never commit `.env`).

# Your OpenCode Go key. Used by our own loop, OpenCode and Prime Agent.
OPENCODE_API_KEY=

# Where our own loop sends requests. Default: OpenCode Go.
# For a local server instead, e.g. Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://opencode.ai/zen/go/v1

# Phone mode: open bench_bot on a phone in the same Wi-Fi (off unless set to 1).
# BENCH_PHONE=1
# Optional fixed phone password (at least 8 characters); otherwise a new one each start.
# BENCH_PHONE_PASSWORD=
