{
  "name": "bench_bot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "lint": "biome check .",
    "format": "biome check --write .",
    "ask": "pnpm --filter @bench_bot/api ask",
    "dev:api": "pnpm --filter @bench_bot/api dev",
    "start": "pnpm --filter @bench_bot/api start",
    "dev:web": "pnpm --filter @bench_bot/web dev",
    "dev": "pnpm --parallel --filter @bench_bot/api --filter @bench_bot/web dev",
    "build": "pnpm --filter @bench_bot/web build",
    "dev:desktop": "pnpm build && pnpm --filter @bench_bot/desktop start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
